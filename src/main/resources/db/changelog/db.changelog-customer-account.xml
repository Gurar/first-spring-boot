<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-customer-account-table" author="j.kozlovski">
        <createTable tableName="CUSTOMER_ACCOUNT">
            <column name="customer_id"  type="bigint">
                <constraints foreignKeyName="CustomerAccountCustomerFk" referencedTableName="CUSTOMER" referencedColumnNames="id" nullable="true"></constraints>
            </column>

            <column name="account_id"  type="bigint">
                <constraints foreignKeyName="CustomerAccountAccountFk" referencedTableName="ACCOUNT" referencedColumnNames="id" nullable="true"></constraints>
            </column>

        </createTable>
    </changeSet>
    <changeSet id="load_customer-account-data" author="j.kozlovski">
        <loadData separator=";" tableName="CUSTOMER_ACCOUNT" file="customer-account.csv" relativeToChangelogFile="true"/>
    </changeSet>
</databaseChangeLog>